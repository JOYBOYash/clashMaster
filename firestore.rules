
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own data in the 'users' collection
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for War Rooms
    match /warRooms/{roomId} {
      // Any authenticated user can read a room, which is needed to check for its existence before joining.
      allow read: if request.auth != null;
      
      // Any authenticated user can create a new room.
      allow create: if request.auth != null;
      
      // Any authenticated user can join a room (add themselves to the members array).
      // A member of the room can update it.
      allow update: if request.auth != null;
    }
  }
}
