rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own data in the 'users' collection
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for War Rooms
    match /warRooms/{roomId} {
      // Any authenticated user can read a room. This is necessary to check
      // for a room's existence and to get updates via listeners.
      allow read: if request.auth != null;
      
      // Any authenticated user can create a new room.
      allow create: if request.auth != null;
      
      // Allow a user to update a room ONLY under specific conditions:
      // 1. To join: The user is adding ONLY themselves to the members list.
      // 2. To modify: The user is already a member of the room.
      allow update: if request.auth != null && 
                    ( (request.resource.data.members == resource.data.members.concat([request.auth.uid])) ||
                      (request.auth.uid in resource.data.members) );
    }
  }
}
